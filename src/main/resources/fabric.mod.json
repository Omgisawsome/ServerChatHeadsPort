{
  "schemaVersion": 1,
  "id": "chatheads",
  "version": "${version}",
  "name": "Chatheads",
  "description": "PORTED-Use player heads in chat via placeholers, completely serverside!",
  "authors": [
    "Camper_Samu",
    "Cody (Original Minestom Extension)",
    "random_revilo (PORTER)"
  ],
  "contact": {
    "sources": "https://github.com/CampHQmc/ServerChatHeads/",
    "issues": "https://github.com/CampHQmc/ServerChatHeads/issues"
  },
  "icon": "assets/chatheads/icon.png",
  "license": "GPL-3.0",
  "environment": "server",
  "entrypoints": {
